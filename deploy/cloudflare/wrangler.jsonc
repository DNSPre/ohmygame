{
  "name": "must-game-studio-proxy",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "game.design.cab/api", "zone_name": "design.cab" },
    { "pattern": "game.design.cab/api/*", "zone_name": "design.cab" },
    { "pattern": "game.design.cab/studio", "zone_name": "design.cab" },
    { "pattern": "game.design.cab/studio/*", "zone_name": "design.cab" }
  ]
}
