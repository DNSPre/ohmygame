{$STUDIO_SITE} {
	root * /srv/studio
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
	}
	route {
		@publicWorkspace {
			not path /api /api/* /admin /admin/*
		}
		redir @publicWorkspace https://game.design.cab{uri} 302

		basic_auth {
			{$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
		}
		redir /admin /admin/ 308
		handle_path /admin/* {
			file_server
		}
		handle_path /api/* {
			@foreign {
				header Origin *
				not {
					header Origin {$STUDIO_ORIGIN}
					header Origin {$STUDIO_CUSTOM_ORIGIN:https://studio.example.invalid}
				}
			}
			respond @foreign 403
			reverse_proxy studio:43210 {
				header_up Authorization "Bearer {$STUDIO_DAEMON_TOKEN}"
			}
		}
		handle {
			file_server
		}
	}
}
