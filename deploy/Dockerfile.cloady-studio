FROM oven/bun:1.4.2 AS bun
FROM node:22.22.0-bookworm-slim AS builder
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /studio
COPY package.json bun.lock bunfig.toml ./
COPY patches ./patches
RUN bun install --frozen-lockfile
COPY . .
RUN bun run prepare:preinstalled-plugins && bun run prepare:examples && bun run build

FROM node:22.22.0-bookworm-slim AS studio
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git gosu && rm -rf /var/lib/apt/lists/* \
    && install -d -o node -g node /data
WORKDIR /studio
COPY --from=builder /usr/local/bin/bun /usr/local/bin/bun
COPY --from=builder /studio/package.json ./package.json
COPY --from=builder /studio/node_modules ./node_modules
COPY --from=builder /studio/dist ./dist
COPY --from=builder /studio/plugins ./plugins
COPY --from=builder /studio/.runtime ./.runtime
ENV NODE_ENV=production DAEMON_HOST=0.0.0.0 DAEMON_PORT=43210 OHMYGAME_DATA_DIR=/data
ENTRYPOINT ["sh", "-ec", "chown node:node /data; exec gosu node \"$@\"", "--"]
CMD ["node", "dist/daemon/server.js"]

